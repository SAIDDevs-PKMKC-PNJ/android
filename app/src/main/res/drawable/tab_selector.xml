<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ ACTIVE TAB: Black dot -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/BluePrimary" />
            <size
                android:width="8dp"
                android:height="8dp" />
        </shape>
    </item>

    <!-- ✅ INACTIVE TAB: Light gray dot -->
    <item android:state_selected="false">
        <shape android:shape="oval">
            <solid android:color="@color/GrayLight" />
            <size
                android:width="8dp"
                android:height="8dp" />
        </shape>
    </item>

    <!-- ✅ DEFAULT: Light gray dot -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/GrayLight" />
            <size
                android:width="8dp"
                android:height="8dp" />
        </shape>
    </item>

</selector>