<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Card Container -->
    <LinearLayout
        android:id="@+id/container_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_container_primary"
        android:padding="24dp"
        android:elevation="6dp">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_avatar_default"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="Profile" />

        <!-- User Name -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/username"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Join Date -->
        <TextView
            android:id="@+id/tv_join_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/createdDate"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:alpha="0.7" />

        <TextView
            android:id="@+id/tv_join_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/createdDate_desc"
            android:textColor="@color/lightBlue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Menu Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <include layout="@layout/item_profile_menu"
                android:id="@+id/menu_informasi"
                android:tag="Informasi Pribadi"
                />

            <include layout="@layout/item_profile_menu"
                android:id="@+id/menu_history"
                android:tag="Posisi Geologi"
                />

            <include layout="@layout/item_profile_menu"
                android:id="@+id/menu_settings"
                android:tag="Settings"
                />

            <include layout="@layout/item_profile_menu"
                android:id="@+id/menu_hapus"
                android:tag="Donasi"
                />
        </LinearLayout>

        <!-- Logout Button -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#F35252"
            android:text="Logout"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_logout_rounded"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/profileOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"/>
    </FrameLayout>


</RelativeLayout>