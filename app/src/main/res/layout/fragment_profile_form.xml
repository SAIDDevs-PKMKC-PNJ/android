<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/white"
        android:contentDescription="Back" />

    <LinearLayout
        android:id="@+id/container_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginTop="150dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_container_primary"
        android:padding="24dp"
        android:elevation="6dp">

        <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/avatar_container"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_circle_light"
            android:clipToOutline="true">

            <!-- Foto profil -->
            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_default"
                android:contentDescription="@string/profile_photo" />

            <!-- Overlay bawah: gradient + teks "Edit foto" -->
            <LinearLayout
                android:id="@+id/overlay_edit"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:background="@drawable/bg_round_12"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_edit_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/change_photo"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp"/>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/avatar_click_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

        </FrameLayout>

        <!-- User Name -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/username"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Form Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <!-- Nama -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_person"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/username"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:inputType="textPersonName"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:drawablePadding="8dp"
                android:hint="Nama Lengkap"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white" />

            <!-- Umur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Umur"
                    android:textColor="#fff"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:textStyle="bold" />
            </LinearLayout>
            <EditText
                android:id="@+id/et_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/Age"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:singleLine="true"
                android:hint="Umur"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#6B7A8A" />

            <!-- Tempat Tinggal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempat Tinggal"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:textStyle="bold" />
            </LinearLayout>
            <EditText
                android:id="@+id/et_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jl. Manggis Jakarta Utara, Tanjung Priuk"
                android:layout_marginTop="12dp"
                android:textColor="#fff"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:inputType="textPostalAddress"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:hint="Alamat"
                android:fontFamily="sans-serif" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white" />

            <!-- No.Telefon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_contact"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No.Telefon"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/et_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="081976897730"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@android:color/transparent"
                android:inputType="phone"
                android:paddingBottom="4dp"
                android:layout_marginBottom="2dp"
                android:hint="Nomor Telepon" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/white" />

        </LinearLayout>

        <!-- Save & Edit Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:text="Simpan"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/success"
                android:background="@drawable/bg_history_btn_primary"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_edit"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Edit"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/lightBlue"
                android:background="@drawable/bg_history_btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>