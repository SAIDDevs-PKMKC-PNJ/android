<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_emergency"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emergencyPrimaryDark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Status / Title -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:padding="16dp"
        android:text="Konfirmasi Darurat"
        android:textColor="@color/emergencyOnPrimary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Countdown Circle -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/circle_timer_background_emergency"
        android:gravity="center"
        android:text="5"
        android:textColor="@color/emergencyOnPrimary"
        android:textSize="72sp"
        android:textStyle="bold" />

    <!-- Cancel Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cancel_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Slider "Geser untuk membatalkan" -->
            <com.ncorti.slidetoact.SlideToActView
                android:id="@+id/slide_to_cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:animate_completion="true"
                app:animation_duration="250"
                app:border_radius="28dp"
                app:inner_color="@android:color/white"
                app:outer_color="@color/emergencyPrimary"
                app:slider_height="56dp"
                app:slider_icon="@drawable/ic_arrow_forward"
                app:slider_icon_color="@color/emergencyPrimaryDark"
                app:slider_locked="false"
                app:text="@string/slider_label"
                app:text_appearance="@style/TextAppearance.Material3.BodyMedium"
                app:text_color="@color/emergencyPrimaryDark" />

            <!-- Hint singkat -->
            <TextView
                android:id="@+id/tv_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Jika tidak ada respons, aplikasi akan menghubungi kontak darurat dan mengirim lokasi Anda."
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>