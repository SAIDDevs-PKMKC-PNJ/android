<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Top Spacer for centering -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logo - Heart with Medical Cross -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="120dp"
            android:layout_marginBottom="8dp">

            <!-- Heart Background -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/icon_foreground"
                android:contentDescription="@string/app_logo" />

        </FrameLayout>

        <!-- Login Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Masuk"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Email Input with Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:boxStrokeColor="@color/BluePrimary"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="25dp"
            app:boxCornerRadiusTopEnd="25dp"
            app:boxCornerRadiusBottomStart="25dp"
            app:boxCornerRadiusBottomEnd="25dp"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/material_dynamic_neutral50"
            app:hintTextColor="@color/material_dynamic_neutral50">

            <EditText
                android:id="@+id/emailEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Email atau Nama Lengkap"
                android:inputType="textEmailAddress"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@color/GrayLight"
                android:background="@android:color/transparent"
                android:paddingStart="56dp"
                android:paddingEnd="16dp"
                tools:ignore="Autofill" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input with Icon -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxStrokeColor="@color/BluePrimary"
            app:boxStrokeWidth="2dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="25dp"
            app:boxCornerRadiusTopEnd="25dp"
            app:boxCornerRadiusBottomStart="25dp"
            app:boxCornerRadiusBottomEnd="25dp"
            app:startIconDrawable="@drawable/ic_lock_24"
            app:startIconTint="@color/material_dynamic_neutral50"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/material_dynamic_neutral50"
            app:hintTextColor="@color/material_dynamic_neutral50">

            <EditText
                android:id="@+id/passwordEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="@color/GrayLight"
                android:background="@android:color/transparent"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                tools:ignore="Autofill" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forget Password Link -->
        <TextView
            android:id="@+id/forgetPasswordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Lupa Password?"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp" />

        <!-- Login Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Masuk"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/BluePrimary"
            app:cornerRadius="28dp"
            android:layout_marginBottom="24dp"
            app:elevation="4dp" />

        <!-- Or Login With Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atau Masuk Dengan"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp" />

        <!-- Social Login Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Google Login -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleSignInButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/GrayLight"
                app:strokeWidth="1dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_google"
                app:iconSize="32dp"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:elevation="2dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Facebook Login (Optional) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/facebookSignInButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/GrayLight"
                app:strokeWidth="1dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_facebook"
                app:iconSize="32dp"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:elevation="2dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Twitter/X Login (Optional) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/twitterSignInButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/GrayLight"
                app:strokeWidth="1dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_twitter"
                app:iconSize="32dp"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:elevation="2dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- LinkedIn Login (Optional) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/linkedinSignInButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/GrayLight"
                app:strokeWidth="1dp"
                app:cornerRadius="32dp"
                app:icon="@drawable/ic_linkedin"
                app:iconSize="32dp"
                app:iconTint="@null"
                app:iconGravity="textTop"
                app:elevation="2dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>

        <!-- Bottom Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Sign Up Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum punya akun? "
                android:textSize="16sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/toRegisterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar sekarang"
                android:textSize="16sp"
                android:textColor="@color/BluePrimary"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>