            android:id="@+id/action_armsPreview_to_armsTest"
            app:destination="@id/armsTestFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
    </fragment>

    <fragment
        android:id="@+id/armsTestFragment"
        android:name="com.pkm.said.screening.ArmTestFragment"
        android:label="Arms Test"
        tools:layout="@layout/fragment_arm_test">
        <action
            android:id="@+id/action_armsTest_to_speechPreview"
            app:destination="@id/speechTestPreviewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
    </fragment>

    <!-- SPEECH TEST - Preview dan Test -->
    <fragment
        android:id="@+id/speechTestPreviewFragment"
        android:name="com.pkm.said.screening.SpeechPreviewFragment"
        android:label="Speech Test Preview"
        tools:layout="@layout/fragment_speech_preview">
        <action
            android:id="@+id/action_speechPreview_to_speechTest"
            app:destination="@id/speechTestFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
    </fragment>

    <fragment
        android:id="@+id/speechTestFragment"
        android:name="com.pkm.said.screening.SpeechTestFragment"
        android:label="Speech Test"
        tools:layout="@layout/fragment_speech_test">
        <action
            android:id="@+id/action_speechTest_to_screeningResult"
            app:destination="@id/screeningResultFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
    </fragment>

