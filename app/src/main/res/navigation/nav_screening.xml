    <!-- SCREENING RESULT -->
    <fragment
        android:id="@+id/screeningResultFragment"
        android:name="com.pkm.said.screening.ScreeningResultFragment"
        android:label="Hasil Screening FAST"
        tools:layout="@layout/fragment_screening_result">
        <action
            android:id="@+id/action_screeningResult_to_facePreview"
            app:destination="@id/faceTestPreviewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
